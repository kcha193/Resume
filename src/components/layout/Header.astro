---
import ThemeToggle from './ThemeToggle.astro';
import NavMenu from './NavMenu.astro';
---

<header class="sticky top-0 z-[var(--z-header)] border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="wrap relative flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="inline-flex items-center gap-3 text-ink"
      aria-label="KC — Kevin Chang home"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-sm)] bg-ink text-sm font-bold tracking-tight text-paper">KC</span>
      <span class="hidden text-[0.95rem] font-semibold tracking-tight sm:inline">Kevin Chang</span>
    </a>

    <NavMenu />

    <div class="flex items-center gap-2">
      <a
        href="/resume"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary hidden !min-h-10 !px-4 !py-2 md:inline-flex"
      >
        Resume
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
