---
import { renderInlineMarkdown } from '../../lib/utils';

interface Props {
  items: Array<{ year: number; citation: string; url?: string }>;
}

const { items } = Astro.props;
const sorted = [...items].sort((a, b) => b.year - a.year);
---

<section id="publications" class="section section--tint" aria-labelledby="publications-heading">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28" data-reveal>
        <h2 id="publications-heading" class="h-section">Research</h2>
        <p class="copy mt-5 max-w-[40ch] text-[0.95rem]">
          Peer-reviewed statistics, modelling and open-source tools. The technical depth behind the commercial work.
        </p>
      </div>
    </div>

    <ol class="ruled border-t border-line lg:col-span-7">
      {sorted.map((pub, i) => (
        <li class="grid grid-cols-[3.25rem_1fr] gap-x-5 py-5 sm:grid-cols-[4rem_1fr]" data-reveal style={`--i:${i % 3}`}>
          <span class="label num pt-0.5">{pub.year}</span>
          <div>
            <p class="text-[0.95rem] leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-ink [&_em]:text-ink" set:html={renderInlineMarkdown(pub.citation)} />
            {pub.url && (
              <a href={pub.url} target="_blank" rel="noopener noreferrer" class="link-u mt-2 inline-block text-[0.88rem] font-semibold">
                View record<span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
