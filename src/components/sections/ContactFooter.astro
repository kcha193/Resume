---
interface Props {
  profile: {
    name: string;
    email: string;
    social: Array<{ platform: string; url: string; handle: string }>;
  };
}
const { profile } = Astro.props;
const year = new Date().getFullYear();
const platformLabels: Record<string, string> = { linkedin: 'LinkedIn', github: 'GitHub' };
---

<footer id="contact" class="section section--tint pb-10" aria-labelledby="contact-heading">
  <div class="wrap">
    <h2 id="contact-heading" class="h-section max-w-[24ch]" data-reveal>
      Looking for senior data science leadership in banking, pricing, or AI?
    </h2>

    <p class="mt-10 sm:mt-14" data-reveal>
      <a
        href={`mailto:${profile.email}`}
        class="link-u break-all text-[clamp(1.35rem,3.6vw,2.75rem)] font-semibold tracking-tight"
      >
        {profile.email}
      </a>
    </p>

    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-[0.95rem] font-semibold" data-reveal>
      {profile.social.map(s => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="noopener me noreferrer"
            class="link-u inline-flex min-h-11 items-center"
          >
            {platformLabels[s.platform] ?? s.platform}<span class="sr-only"> (opens in new tab)</span>
          </a>
        </li>
      ))}
      <li>
        <a href="/resume" target="_blank" rel="noopener noreferrer" class="link-u inline-flex min-h-11 items-center">
          Resume<span class="sr-only"> (opens in new tab)</span>
        </a>
      </li>
    </ul>

    <div class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-[0.82rem] text-muted">
      <p>&copy; {year} {profile.name}</p>
      <p>
        Built with{' '}
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="link-u">Astro</a>
        {' '}&amp; Tailwind CSS
      </p>
    </div>
  </div>
</footer>
