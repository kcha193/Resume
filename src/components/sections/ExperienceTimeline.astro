---
import ExperienceCard from './ExperienceCard.astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'experience'>[];
}

const { items } = Astro.props;

const renderedItems = await Promise.all(
  items.map(async (entry) => {
    const { Content } = await render(entry);

    return {
      entry,
      summary: Content,
    };
  }),
);
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 pb-4" data-reveal>
      <h2 id="experience-heading" class="h-section">Experience</h2>
      <p class="copy max-w-[44ch] text-[0.95rem]">
        From statistical consulting and government policy modelling to banking pricing and model assurance at ASB.
      </p>
    </div>

    <div class="mt-8 border-t border-line">
      {renderedItems.map((item, i) => (
        <ExperienceCard
          entry={item.entry}
          summary={item.summary}
          isLast={i === renderedItems.length - 1}
        />
      ))}
    </div>
  </div>
</section>
