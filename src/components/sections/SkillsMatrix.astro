---
interface Props {
  tiers: Array<{ title: string; core?: number; items: string[] }>;
}

const { tiers } = Astro.props;
const DEFAULT_CORE = 3;

const domains = tiers.map(tier => {
  const n = tier.core ?? DEFAULT_CORE;
  return { title: tier.title, core: tier.items.slice(0, n), support: tier.items.slice(n) };
});
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28" data-reveal>
        <h2 id="skills-heading" class="h-section">Skills</h2>
        <p class="copy mt-5 max-w-[34ch] text-[0.95rem]">
          Grouped by capability. Deeper expertise first; supporting tools beneath.
        </p>
      </div>
    </div>

    <div class="ruled border-t border-line lg:col-span-8">
      {domains.map((domain, i) => (
        <div class="grid gap-3 py-7 sm:grid-cols-[11rem_1fr] sm:gap-8" data-reveal style={`--i:${i % 3}`}>
          <h3 class="text-[0.95rem] font-semibold leading-snug tracking-tight sm:pt-1">{domain.title}</h3>
          <div>
            <ul class="flex flex-wrap gap-x-6 gap-y-1 text-xl font-medium tracking-tight sm:text-[1.4rem]">
              {domain.core.map(item => <li class="before:mr-2.5 before:inline-block before:h-1.5 before:w-1.5 before:bg-brand before:align-middle">{item}</li>)}
            </ul>
            {domain.support.length > 0 && (
              <p class="copy mt-3 text-[0.92rem] leading-relaxed">
                {domain.support.join('  ·  ')}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
