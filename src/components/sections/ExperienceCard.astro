---
import { formatDate, renderInlineMarkdown } from '../../lib/utils';
import type { CollectionEntry, RenderResult } from 'astro:content';

type AstroComponentFactory = RenderResult['Content'];

interface Props {
  entry: CollectionEntry<'experience'>;
  summary: AstroComponentFactory;
  isLast: boolean;
}

const { entry, summary: Summary, isLast } = Astro.props;
const { title, company, location, startDate, endDate, tags, highlights } = entry.data;

const isCurrent = endDate === null;
const VISIBLE = 3;
const lead = highlights.slice(0, VISIBLE);
const more = highlights.slice(VISIBLE);
---

<article
  data-reveal
  class:list={['grid gap-6 py-10 lg:grid-cols-12 lg:gap-x-10 lg:py-14', !isLast && 'border-b border-line']}
>
  <header class="lg:col-span-4">
    <div class="lg:sticky lg:top-24">
      <p class="label flex items-center gap-2.5">
        <span
          class:list={[
            'h-2.5 w-2.5 shrink-0 rounded-full border',
            isCurrent ? 'border-brand bg-brand' : 'bg-transparent',
          ]}
          style={isCurrent ? '' : 'border-color: var(--line-strong)'}
          aria-hidden="true"
        ></span>
        <span>{formatDate(startDate)} – {formatDate(endDate)}</span>
      </p>
      <p class:list={['mt-4 font-semibold tracking-tight', isCurrent ? 'text-3xl' : 'text-2xl']}>{company}</p>
      <p class="copy mt-1 text-[0.92rem]">{location}</p>
    </div>
  </header>

  <div class="lg:col-span-8">
    <h3 class:list={['font-semibold leading-tight tracking-tight', isCurrent ? 'text-2xl sm:text-[1.7rem]' : 'text-xl']}>
      {title}
    </h3>

    <div class="lede mt-3 text-[1.02rem]">
      <Summary />
    </div>

    <ul class="mt-7 grid gap-4">
      {lead.map((h, i) => (
        <li
          class:list={[
            'relative pl-5 leading-relaxed before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-3 before:bg-brand',
            i === 0 ? 'text-ink font-medium' : 'text-muted',
          ]}
          set:html={renderInlineMarkdown(h)}
        />
      ))}
    </ul>

    {more.length > 0 && (
      <details class="group mt-4">
        <summary class="link-u inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-[0.92rem] font-semibold [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Show {more.length} more</span>
          <span class="hidden group-open:inline">Show less</span>
        </summary>
        <ul class="mt-3 grid gap-4">
          {more.map(h => (
            <li
              class="relative pl-5 leading-relaxed text-muted before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-3 before:bg-brand"
              set:html={renderInlineMarkdown(h)}
            />
          ))}
        </ul>
      </details>
    )}

    {tags.length > 0 && (
      <p class="label mt-7">{tags.join('  ·  ')}</p>
    )}
  </div>
</article>
