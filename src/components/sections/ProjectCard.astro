---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** lead = headline case study, case = other featured case study, row = additional public work */
  variant?: 'lead' | 'case' | 'row';
  index?: number;
}

const { entry, variant = 'row', index = 0 } = Astro.props;
const { title, blurb, url, stack, category, year, problem, approach, impact } = entry.data;
const proofPoint = entry.body?.trim();

const caseStudy = [
  { label: 'Problem', value: problem },
  { label: 'Approach', value: approach },
  { label: 'Impact', value: impact },
].filter((row): row is { label: string; value: string } => Boolean(row.value));

const categoryLabels: Record<string, string> = {
  agent: 'AI system',
  app: 'Decision app',
  dashboard: 'Dashboard',
  policy: 'Policy model',
  research: 'Research tool',
  tool: 'Tooling',
};
const categoryLabel = categoryLabels[category] ?? category;
---

{variant === 'lead' && (
  <article data-reveal class="grid gap-10 pb-14 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-5">
      <p class="num select-none text-[clamp(4rem,10vw,7.5rem)] font-semibold leading-[0.85] tracking-[-0.06em] text-transparent [-webkit-text-stroke:1.5px_var(--line-strong)]" aria-hidden="true">{year}</p>
      <p class="label mt-6">{year} · {categoryLabel}</p>
      <h3 class="mt-3 text-3xl font-semibold leading-[1.05] tracking-tight sm:text-4xl">
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer" class="link-u" aria-label={`${title} (opens in new tab)`}>{title}</a>
        ) : title}
      </h3>
      <p class="copy mt-4">{blurb}</p>
      <p class="label mt-6">{stack.slice(0, 5).join('  ·  ')}</p>
    </div>

    <dl class="ruled self-end border-t border-line lg:col-span-7">
      {caseStudy.map(row => (
        <div
          class:list={[
            'grid gap-2 py-5 sm:grid-cols-[6.5rem_1fr] sm:gap-6',
            row.label === 'Impact' && 'border-l-2 !border-t pl-4 sm:pl-5',
          ]}
          style={row.label === 'Impact' ? 'border-left-color: var(--brand)' : ''}
        >
          <dt class="label pt-0.5">{row.label}</dt>
          <dd class:list={['leading-relaxed', row.label === 'Impact' ? 'text-lg font-semibold tracking-tight' : 'text-muted']}>{row.value}</dd>
        </div>
      ))}
      {caseStudy.length === 0 && proofPoint && <p class="copy py-5">{proofPoint}</p>}
    </dl>
  </article>
)}

{variant === 'case' && (
  <article data-reveal style={`--i:${index}`} class="grid gap-6 border-t border-line py-10 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-4">
      <p class="label">{year} · {categoryLabel}</p>
      <h3 class="mt-3 text-2xl font-semibold leading-tight tracking-tight">
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer" class="link-u" aria-label={`${title} (opens in new tab)`}>{title}</a>
        ) : title}
      </h3>
      <p class="label mt-4">{stack.slice(0, 4).join('  ·  ')}</p>
    </div>

    <dl class="grid gap-x-8 gap-y-6 lg:col-span-8 md:grid-cols-3">
      {caseStudy.map(row => (
        <div
          class:list={['border-t pt-3', row.label !== 'Impact' && 'border-line']}
          style={row.label === 'Impact' ? 'border-top-color: var(--brand); border-top-width: 2px' : ''}
        >
          <dt class="label">{row.label}</dt>
          <dd class:list={['mt-2 text-[0.94rem] leading-relaxed', row.label === 'Impact' ? 'font-semibold text-ink' : 'text-muted']}>{row.value}</dd>
        </div>
      ))}
      {caseStudy.length === 0 && <p class="copy md:col-span-3">{proofPoint ?? blurb}</p>}
    </dl>
  </article>
)}

{variant === 'row' && (
  <li data-reveal class="group grid grid-cols-[3.25rem_1fr] gap-x-5 gap-y-1 py-5 sm:grid-cols-[4rem_minmax(0,1fr)_minmax(0,1.6fr)] sm:gap-x-8">
    <span class="label num pt-1">{year}</span>
    <div>
      <h3 class="font-semibold leading-snug tracking-tight">
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer" class="link-u" aria-label={`${title} (opens in new tab)`}>{title}</a>
        ) : title}
      </h3>
      <p class="label mt-1">{categoryLabel}</p>
    </div>
    <p class="copy col-start-2 text-[0.92rem] leading-relaxed sm:col-start-3">{blurb}</p>
  </li>
)}
