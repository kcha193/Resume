---
import { renderInlineMarkdown } from '../../lib/utils';

interface Props {
  summary: string;
  cards: Array<{ label: string; title: string; detail: string }>;
  highlights: Array<{ value: string; label: string }>;
}
const { summary, cards, highlights } = Astro.props;
const match = summary.match(/^\*\*(.+?)\*\*[:\s]*([\s\S]*)$/);
const lead = match ? match[1] : summary;
const rest = match ? match[2] : '';
---

<section id="about" class="section" aria-labelledby="snapshot-heading">
  <div class="wrap">
    <div class="grid gap-9 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="label mb-4 uppercase tracking-[0.12em]">01 / About the approach</p>
        <h2 id="snapshot-heading" class="h-section max-w-[16ch]">{lead}</h2>
      </div>
      <div class="lg:col-span-8" data-reveal>
        {rest && <p class="lede max-w-[62ch] text-[clamp(1.1rem,1.5vw,1.45rem)]" set:html={renderInlineMarkdown(rest)} />}
      </div>
    </div>

    <dl class="proof-band mt-12 grid gap-x-8 gap-y-7 border-y border-line py-8 md:grid-cols-3 lg:mt-16">
      {highlights.map((item, i) => (
        <div class:list={['min-w-0', i > 0 && 'md:border-l md:border-line md:pl-8']} data-reveal style={`--i:${i}`}>
          <dt class="text-[clamp(1.45rem,2.5vw,2rem)] font-semibold leading-tight tracking-[-0.04em]">{item.value}</dt>
          <dd class="copy mt-2 text-[0.9rem] leading-relaxed">{item.label}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-16 grid gap-7 lg:mt-20 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-3" data-reveal>
        <p class="label uppercase tracking-[0.12em]">Capabilities</p>
        <h3 class="mt-3 text-[clamp(1.55rem,2.7vw,2.1rem)] font-semibold leading-[1.15] tracking-[-0.04em]">
          From the question to the decision.
        </h3>
        <p class="copy mt-4 text-[0.95rem]">Four lenses I bring to complex analytical work.</p>
      </div>
      <dl class="grid gap-3 sm:grid-cols-2 lg:col-span-9">
        {cards.map((card, i) => (
          <div class="capability-card relative flex min-h-[14rem] flex-col rounded-[var(--radius-md)] p-6 sm:p-7" data-reveal style={`--i:${i % 2}`}>
            <div class="flex items-start justify-between gap-4">
              <dt class="label uppercase tracking-[0.09em]">{card.label}</dt>
              <span class="label" aria-hidden="true">0{i + 1}</span>
            </div>
            <dd class="mt-auto pt-8">
              <p class="text-[1.24rem] font-semibold leading-tight tracking-[-0.03em]">{card.title}</p>
              <p class="copy mt-3 text-[0.94rem]">{card.detail}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
