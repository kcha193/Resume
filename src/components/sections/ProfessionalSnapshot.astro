---
import { renderInlineMarkdown } from '../../lib/utils';

interface Props {
  summary: string;
  cards: Array<{ label: string; title: string; detail: string }>;
  highlights: Array<{ value: string; label: string }>;
}

const { summary, cards, highlights } = Astro.props;

// The summary opens with a bold lead statement ("**Lead**: rest…"): the lead
// becomes the section heading, the remainder the supporting paragraph.
const match = summary.match(/^\*\*(.+?)\*\*[:\s]*([\s\S]*)$/);
const lead = match ? match[1] : summary;
const rest = match ? match[2] : '';

const [primary, ...secondary] = highlights;
const [figure, ...unit] = primary.value.split(' ');
---

<section id="about" class="section" aria-labelledby="snapshot-heading">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="num text-[clamp(4.5rem,11vw,8rem)] font-semibold leading-[0.85] tracking-[-0.06em]">{figure}</p>
      <p class="mt-2 text-2xl font-semibold tracking-tight">{unit.join(' ')}</p>
      <p class="copy mt-3 max-w-[30ch] text-[0.95rem]">{primary.label}</p>

      <dl class="ruled mt-10 border-t border-line">
        {secondary.map(item => (
          <div class="py-4">
            <dt class="text-lg font-semibold tracking-tight">{item.value}</dt>
            <dd class="copy mt-1 text-[0.92rem]">{item.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="lg:col-span-8">
      <h2 id="snapshot-heading" class="h-section max-w-[22ch]" data-reveal>{lead}</h2>
      {rest && (
        <p class="lede mt-6" data-reveal set:html={renderInlineMarkdown(rest)} />
      )}

      <dl class="mt-14 grid gap-x-10 border-t border-line sm:grid-cols-2">
        {cards.map((card, i) => (
          <div class="border-b border-line py-6" data-reveal style={`--i:${i % 2}`}>
            <dt class="label">{card.label}</dt>
            <dd class="mt-2">
              <span class="block text-[1.08rem] font-semibold leading-snug tracking-tight">{card.title}</span>
              <span class="copy mt-2 block text-[0.94rem] leading-relaxed">{card.detail}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
