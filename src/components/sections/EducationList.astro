---
interface Props {
  items: Array<{
    degree: string;
    university: string;
    year: number;
  }>;
  languages: Array<{ name: string; level: string }>;
  interests: string[];
}

const { items, languages, interests } = Astro.props;
---

<section id="education" class="section" aria-labelledby="education-heading">
  <div class="wrap grid gap-10 md:grid-cols-12 md:gap-x-10">
    <h2 id="education-heading" class="text-xl font-semibold tracking-tight md:col-span-3" data-reveal>Education</h2>

    <div class="grid gap-10 md:col-span-9 md:grid-cols-[1.6fr_1fr_1fr]" data-reveal>
      <ul class="ruled border-t border-line">
        {items.map(item => (
          <li class="grid grid-cols-[3.25rem_1fr] gap-x-4 py-3">
            <span class="label num pt-0.5">{item.year}</span>
            <p class="text-[0.95rem] leading-snug">
              <span class="font-medium">{item.degree}</span>
              <span class="copy block text-[0.88rem]">{item.university}</span>
            </p>
          </li>
        ))}
      </ul>

      <div class="border-t border-line pt-3">
        <h3 class="label">Languages</h3>
        <ul class="mt-2 grid gap-1 text-[0.95rem]">
          {languages.map(l => (
            <li>{l.name} <span class="copy text-[0.88rem]">· {l.level}</span></li>
          ))}
        </ul>
      </div>

      <div class="border-t border-line pt-3">
        <h3 class="label">Outside work</h3>
        <p class="mt-2 text-[0.95rem]">{interests.join(', ')}</p>
      </div>
    </div>
  </div>
</section>
