---
import { Image } from 'astro:assets';
import avatarSrc from '../../assets/avatar.jpg';

interface Props {
  profile: {
    name: string;
    tagline: string;
    location: string;
    social: Array<{ platform: string; url: string; handle: string }>;
    hero: {
      eyebrow: string;
      heading: string;
      subheading: string;
      stats: string[];
    };
  };
  current?: { title: string; company: string };
}
const { profile, current } = Astro.props;
const { hero } = profile;
const linkedin = profile.social.find(s => s.platform === 'linkedin');
const words = hero.heading.trim().split(/\s+/);
const lead = words.slice(0, -2).join(' ');
const accent = words.slice(-2).join(' ');
---

<section class="hero-shell relative overflow-hidden" aria-labelledby="hero-heading">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative z-10 grid gap-12 pb-14 pt-14 md:pb-20 md:pt-20 lg:grid-cols-12 lg:gap-x-12 lg:pb-24 lg:pt-24">
    <div class="flex flex-col lg:col-span-7">
      <div class="rise mb-10 flex flex-wrap items-center gap-x-4 gap-y-2" style="--d:0">
        <span class="label inline-flex items-center gap-2 font-semibold uppercase tracking-[0.14em]">
          <span class="hero-status" aria-hidden="true"></span> Applied statistics / Decision science
        </span>
        <span class="label hidden sm:inline" aria-hidden="true">/</span>
        <span class="label">{profile.location}</span>
      </div>

      <p class="rise mb-4 text-[1.05rem] font-semibold tracking-tight" style="--d:1">{profile.name} <span class="ml-2 font-normal text-muted">PhD, Statistics</span></p>
      <h1 id="hero-heading" class="display hero-display rise max-w-[15ch]" style="--d:2">
        {lead} <span class="mark">{accent}</span>
      </h1>
      <p class="lede rise mt-8 max-w-[52ch]" style="--d:3">{hero.subheading}</p>

      <div class="rise mt-9 flex flex-wrap items-center gap-3 sm:gap-4" style="--d:4">
        <a href="#projects" class="btn btn-primary">
          See selected work
          <svg class="arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/resume" target="_blank" rel="noopener noreferrer" class="btn">
          View résumé
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3"/><path d="M13 3h8v8"/><path d="m21 3-10 10"/></svg>
        </a>
        {linkedin && (
          <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class="link-u inline-flex min-h-11 items-center font-semibold">
            LinkedIn <span class="sr-only">(opens in new tab)</span>
          </a>
        )}
      </div>

      <div class="rise mt-14 grid gap-5 border-t border-line pt-5 sm:grid-cols-2 lg:mt-auto lg:pt-8" style="--d:5">
        <div>
          <p class="label uppercase tracking-[0.12em]">Current focus</p>
          <p class="mt-1 text-[0.98rem] font-semibold tracking-tight">{current ? `${current.title} · ${current.company}` : hero.eyebrow}</p>
        </div>
        <div>
          <p class="label uppercase tracking-[0.12em]">Working across</p>
          <p class="mt-1 text-[0.98rem] font-semibold tracking-tight">Pricing · Machine learning · Model risk</p>
        </div>
      </div>
    </div>

    <figure class="rise relative m-0 min-w-0 lg:col-span-5 lg:pl-4" style="--d:3">
      <div class="hero-photo-wrap relative overflow-hidden rounded-[var(--radius-md)]">
        <Image
          src={avatarSrc}
          alt={`Portrait of ${profile.name}`}
          width={640}
          height={640}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 35vw, (min-width: 640px) 60vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-photo h-full w-full object-cover object-top"
        />
        <div class="hero-photo-frame pointer-events-none absolute inset-4 rounded-[var(--radius-sm)]" aria-hidden="true"></div>
        <span class="hero-photo-label absolute left-6 top-6 rounded-[var(--radius-sm)] px-3 py-2 text-[0.76rem] font-semibold tracking-[0.12em] uppercase">
          Research → Impact
        </span>
      </div>
      <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-2">
        <span class="label">01 / The person behind the models</span>
        <span class="label">Auckland, NZ</span>
      </figcaption>
      <div class="hero-caption mt-7 grid grid-cols-2 gap-3">
        {hero.stats.slice(0, 4).map((stat, index) => (
          <div class="border-l border-line-strong pl-3">
            <span class="label block">0{index + 1}</span>
            <span class="mt-1 block text-[0.9rem] font-semibold leading-snug">{stat}</span>
          </div>
        ))}
      </div>
    </figure>
  </div>
</section>
