---
import { Image } from 'astro:assets';
import avatarSrc from '../../assets/avatar.jpg';

interface Props {
  profile: {
    name: string;
    tagline: string;
    location: string;
    social: Array<{ platform: string; url: string; handle: string }>;
    hero: {
      eyebrow: string;
      heading: string;
      subheading: string;
    };
  };
  /** Current role, shown as a quiet caption under the portrait. */
  current?: { title: string; company: string };
}
const { profile, current } = Astro.props;
const { hero } = profile;

const linkedin = profile.social.find(s => s.platform === 'linkedin');

// Highlight the closing phrase of the headline (last two words).
const words = hero.heading.split(' ');
const lead = words.slice(0, -2).join(' ');
const accent = words.slice(-2).join(' ');
---

<section class="relative overflow-hidden" aria-labelledby="hero-heading">
  <div class="guides pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="wrap relative pb-16 pt-12 sm:pb-20 sm:pt-16 lg:pb-24 lg:pt-20">
    <p class="rise mb-6 flex flex-wrap items-baseline gap-x-3 gap-y-1" style="--d:0">
      <span class="text-lg font-semibold tracking-tight">{profile.name}</span>
      <span class="label">{hero.eyebrow} · {profile.location}</span>
    </p>

    <h1 id="hero-heading" class="display rise max-w-[19ch] sm:max-w-[24ch] lg:max-w-[26ch]" style="--d:1">
      {lead} <span class="mark">{accent}</span>
    </h1>

    <div class="mt-10 grid items-center gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="lede rise" style="--d:2">{hero.subheading}</p>

        <div class="rise mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:3">
          <a href="#experience" class="btn btn-primary">
            Explore experience
            <svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/resume" target="_blank" rel="noopener noreferrer" class="btn">Resume</a>
          {linkedin && (
            <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class="link-u inline-flex min-h-11 items-center text-[0.94rem] font-semibold">
              LinkedIn
            </a>
          )}
        </div>
      </div>

      <figure class="rise group relative mx-0 w-full max-w-[17rem] lg:col-span-4 lg:col-start-9 lg:max-w-none" style="--d:3">
        <div class="relative">
        <div
          class="absolute inset-0 translate-x-3 translate-y-3 rounded-[var(--radius-md)] bg-brand transition-transform duration-500 [transition-timing-function:var(--ease)] group-hover:translate-x-4 group-hover:translate-y-4"
          aria-hidden="true"
        ></div>
        <Image
          src={avatarSrc}
          alt={`${profile.name}, ${profile.tagline.split('|')[0].trim()}`}
          width={640}
          height={640}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 24rem, 17rem"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-square w-full rounded-[var(--radius-md)] object-cover object-top grayscale-[0.15] contrast-[1.03]"
        />
        </div>
        {current && (
          <figcaption class="label mt-7">
            Now · {current.title}, {current.company}
          </figcaption>
        )}
      </figure>
    </div>
  </div>
</section>
