---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import ContactFooter from '../components/sections/ContactFooter.astro';
import type { ArticleMetadata } from '../lib/seo';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  title: string;
  description: string;
  label: string;
  backHref: string;
  backLabel: string;
  canonicalUrl?: string;
  article?: ArticleMetadata;
}
const { profile, title, description, label, backHref, backLabel, canonicalUrl, article } = Astro.props;
---

<BaseLayout profile={profile} title={`${title} | ${profile.name}`} description={description} canonicalUrl={canonicalUrl} article={article}>
  <Header />
  <main id="main-content" tabindex="-1" class="section !border-t-0">
    <article class="wrap reading">
      <a href={backHref} class="link-u inline-flex min-h-11 items-center text-sm font-semibold">← {backLabel}</a>
      <p class="label mt-10">{label}</p>
      <h1 class="h-section mt-4">{title}</h1>
      <p class="lede mt-6">{description}</p>
      <slot name="metadata" />
      <div class="prose mt-12 border-t border-line pt-8"><slot /></div>
    </article>
  </main>
  <ContactFooter profile={profile} />
</BaseLayout>
